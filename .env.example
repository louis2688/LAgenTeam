# --- LLM providers ---
# Leave ANTHROPIC_API_KEY empty to run on the mock provider (scaffold boots with no keys).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Ollama (local, free tier). Empty OLLAMA_HOST => mock fallback for local-tier tasks.
# In Docker, point at the host: http://host.docker.internal:11434
OLLAMA_HOST=
OLLAMA_MODEL=qwen3

# --- Infra ---
DATABASE_URL=postgresql://lagenteam:lagenteam@localhost:5432/lagenteam
REDIS_URL=redis://localhost:6379/0

# --- Budget ---
# Default hard token ceiling per run. The orchestrator KILLS a run when it is exceeded.
DEFAULT_BUDGET_TOKENS=50000

# Tool execution: enable run_shell (arbitrary shell in the run workspace). Off by default.
ALLOW_SHELL=0

# --- Security ---
# Set API_TOKEN to require Bearer auth on the API (the web proxy injects it server-side).
API_TOKEN=
# Password for Redis (compose passes it to redis-server and into REDIS_URL).
REDIS_PASSWORD=
# Allowed CORS origin for the API.
WEB_ORIGIN=http://localhost:3000
# Optional stronger Postgres password (requires a fresh pgdata volume to take effect).
POSTGRES_PASSWORD=lagenteam
